# Stack settings for compose project `pwmig2`: the second CRM stack, lane 2 of the migration queue
# (second --env-file, after the fresh ase-crm/.env). Only the CRM services: Agent Manager and stackctl
# are lane 1's project (`pwmig`). The suite inside `am` sees this stack on these localhost ports
# (stack.sh test-env ui2) through the `pwmig2-ports` sidecar; nothing is published on the host.
STACK=pwmig2
APP_PORT=8084
MARIADB_PORT=3309
MINIO_API_PORT=9004
BILLING_PORT=8110
KC_PORT=8281
# Its own network: the CRM services find each other by service name (mariadb, keycloak, billing),
# which would resolve to both stacks if they shared pwmig-net. pwmig-am is attached to it by stackctl.
PWMIG2_SUBNET=172.31.251.0/24
PWMIG_KIT=/src/agentmanager/deploy/robot-migration
