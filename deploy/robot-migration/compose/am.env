# Agent Manager inside pwmig-am. State lives in the pwmig_am-state volume (/data), repos in pwmig_work (/work).
HOST=0.0.0.0
PORT=3030
NODE_ENV=production
CLAUDE_DIR=/data/am/claude
AGENT_RUNS_DIR=/data/am/workflow-runs
AGENT_WORKSPACE_ROOT=/data/am/workspace
AGENT_CHANNELS_FILE=/data/am/channels.json
AGENT_USERS_DIR=/data/am/users
AGENT_MANAGER_SECRET_FILE=/data/am/secret
# The address you open through the SSH tunnel (ssh -L 3031:172.31.250.10:3030 ...); used in notification links.
AGENT_MANAGER_URL=http://localhost:3031
# Reachable only through the tunnel (no published port). Anyone who can SSH to the host can reach it.
AUTH_DISABLED=1
TEAM_SEED_ON_BOOT=0
# Nothing of the SDLC pipeline runs here: no schedules, CI polling or Jira watches.
SCHEDULER_DISABLED=1
CI_POLLER_DISABLED=1
WATCHER_DISABLED=1
# One porting run at a time, long enough for a big folder.
AGENT_RUN_MAX_MINUTES=600
AGENT_RUN_MAX_TOKENS=40000000
