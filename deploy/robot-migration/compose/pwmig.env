# Stack settings for compose project `pwmig` (second --env-file, after the fresh ase-crm/.env).
# The suite inside `am` sees the stack on these localhost ports (stack.sh test-env ui), through the
# `ports` sidecar; nothing is published on the host.
STACK=pwmig
APP_PORT=8083
MARIADB_PORT=3308
MINIO_API_PORT=9003
BILLING_PORT=8109
KC_PORT=8280
# Our own network. The builder's preflight refuses to start if another docker network already uses it.
PWMIG_SUBNET=172.31.250.0/24
PWMIG_AM_IP=172.31.250.10
# Where this kit sits inside the builder and stackctl containers (the fresh agentmanager clone).
PWMIG_KIT=/src/agentmanager/deploy/robot-migration
