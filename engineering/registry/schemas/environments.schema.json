{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment profiles",
  "type": "object",
  "required": ["environments"],
  "additionalProperties": false,
  "properties": {
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "facts"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["workstation", "lab_docker_host"] },
          "description": { "type": "string", "minLength": 1 },
          "detect": {
            "type": "object",
            "required": ["os_release_id", "wsl"],
            "additionalProperties": false,
            "properties": {
              "os_release_id": { "type": "string", "minLength": 1 },
              "wsl": { "type": "boolean" }
            }
          },
          "facts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    }
  }
}
