ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Jira-backed ticket source (B5) — set all three to poll Jira instead of the
# file-backed ~/.claude/watch-tickets/<watchId>.json stub. Leave unset to
# keep using the stub (tests and offline work always can, regardless).
#
# JIRA_BASE_URL is optional here: it can also be set on the Settings page, and
# this variable overrides that when it is set to a non-empty value. The TOKEN
# never moves — it stays env-only (or per-developer on the profile page).
# An empty line below is "unset", not "pinned to empty".
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Posting a run's outcome back to the ticket is OFF by default. Writing to
# Jira is a confirm-before-acting operation — set this to exactly "1" only
# after you've reviewed the rendered comment (written to every run's
# jira-comment.json artifact regardless of this setting).
#
# Also settable on the Settings page. "1" pins it on and "0" pins it OFF for
# the whole instance, over anything saved there — which is how a shared
# deployment guarantees nothing writes to Jira.
JIRA_POST_ENABLED=

# Optional: appended as "For vis: <name>" on a posted/rendered comment.
# Omitted entirely (never a placeholder) when unset. Also on the Settings page;
# this overrides it.
JIRA_COMMENT_FOR_VIS_NAME=

# Optional: the project key written into each run's generated jira-cli config.
# Also on the Settings page; this overrides it.
JIRA_DEFAULT_PROJECT=

# Identity on a shared instance. AUTH_DISABLED=1 skips sign-in and treats every
# request as DEV_USER (default "local"); leave it unset on the team instance and
# set the GitHub OAuth app registered under GITHUB_ORG (callback
# <AGENT_MANAGER_URL>/api/auth/callback). AGENT_MANAGER_SECRET (32+ characters)
# seals the session cookie and encrypts stored tokens. Left unset, one is
# generated at first boot and kept in ~/.agent-manager/secret
# (AGENT_MANAGER_SECRET_FILE overrides the path).
AUTH_DISABLED=
DEV_USER=
AGENT_MANAGER_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=
AGENT_MANAGER_URL=
# Optional: a 32+ character bearer token for scripts and operators; requests
# carrying it act as AGENT_MANAGER_API_LOGIN (their credentials, their name).
AGENT_MANAGER_API_TOKEN=
AGENT_MANAGER_API_LOGIN=

# Runs: per-run caps, Slack webhook for run transitions, CI check polling,
# and where the provisioner clones product checkouts.
#
# The two caps are also on the Settings page; setting either here pins it and
# the page says so rather than accepting a value it will ignore.
AGENT_RUN_MAX_MINUTES=
AGENT_RUN_MAX_TOKENS=
SLACK_WEBHOOK_URL=
AGENT_WORKSPACE_ROOT=

# How many runs of the DEFAULT concurrency group may work at once. Saving a cap
# for "Ungrouped" in the Groups editor on the Workflows page replaces this; it
# is the fallback for an instance where nobody has.
AGENT_MAX_CONCURRENT_PIPELINES=

# Read once at boot, before the timer each one controls exists — so none of
# them can be a toggle in the UI, and changing one needs a restart. The
# Settings page shows their state, as booted, under "Instance".
# *_DISABLED=1 turns off; RESUME_ON_BOOT and TEAM_SEED_ON_BOOT turn off with =0.
CI_POLL_SECONDS=
CI_POLLER_DISABLED=
WATCHER_DISABLED=
SCHEDULER_DISABLED=
RUN_QUEUE_DISABLED=
RESUME_ON_BOOT=
TEAM_SEED_ON_BOOT=

# Optional: route the agents' Claude traffic through a proxy (for example the
# teamclaude account-rotation proxy on the host). Passed to claude untouched.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
